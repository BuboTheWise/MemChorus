vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

enforce: "enforce(input_text)"
trigger: "Behavioral Trigger"
autorecall: "AutoRecall Engine"
autostorage: "AutoStorage Engine"
result: "EnforcementResult"

enforce -> trigger
trigger -> autorecall
autorecall -> autostorage
autostorage -> result