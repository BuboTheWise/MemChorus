vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

step1: "enforce(input_text)"

step2: "Behavioral Trigger\n(Plays decision points from text)"

step3: "AutoRecall Engine\n(Query relevant memories per point)"

step4: "AutoStorage Engine\n(Captures outcomes, dedup window)"

step5: "EnforcementResult (dataclass)\n(Structured summary to caller)"

# Pipeline chain
step1 -> step2
step2 -> step3
step3 -> step4
step4 -> step5
