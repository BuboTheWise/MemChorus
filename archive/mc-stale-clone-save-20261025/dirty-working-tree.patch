diff --git a/src/memchorus/tunnel_signal.py b/src/memchorus/tunnel_signal.py
new file mode 100644
index 0000000..b0d5155
--- /dev/null
+++ b/src/memchorus/tunnel_signal.py
@@ -0,0 +1,213 @@
+"""
+Cross-domain tunnel adjacency signal (#225, sub-part 1).
+
+Wires MemPalace's tunnel surface (cross-domain bridges linking rooms in
+different wings) into MemChorus's auto-recall loop.
+
+Design principle: **pure, testable, degradable.**  The three public functions
+here never talk to the network, never throw, and always fall back to an empty
+list when their inputs are missing or malformed.  That lets the orchestrator's
+recall path call them unconditionally and let the *data* — not the caller —
+decide whether cross-domain context is available.
+
+API:
+    tunnel_linked_rooms(active_wing, wing_map) -> list[str]
+        Given the active wing and a mapping {source_wing: [target_wing, ...]},
+        return the list of wings linked from *active_wing* via a tunnel.
+        De-duplicated, order-preserving, case-insensitive.
+
+    tunnel_adjacent(drawers, active_wing, wing_map, query=None,
+                    similarity=static_similarity, min_similarity=0.25,
+                    limit=3) -> list[dict]
+        Given a list of candidate drawers (each a dict with at least ``key``
+        and ``content``, optionally ``wing``), filter to those whose ``wing``
+        is a tunnel-adjacent wing of *active_wing*, apply an optional
+        text-similarity floor against *query*, and return up to *limit*
+        copies with a ``cross_domain=True`` tag and a ``tunnel_adjacent_to``
+        field naming the linking active wing.  Pure: no I/O, no exceptions.
+
+    tunnel_tag(item) -> dict
+        Return *item* with the ``cross_domain=True`` tag and a
+        ``tunnel_adjacent_to`` field added (used by the orchestrator to
+        preserve the tag through scoring).
+
+Backward compatibility: when ``wing_map`` is empty/None, no tunnels exist and
+the function returns ``[]``.  When ``query`` is None/empty, the similarity floor
+is skipped.  Every code path is total — no caller needs a ``try:``.
+
+This module is intentionally *small*: it is the *pure* half of the
+cross-domain tunnel signal.  The I/O half (fetching ``find_tunnels`` /
+``follow_tunnels`` from the MemPalace MCP) lives in
+:meth:`memchorus.mempalace_memory_source.MemPalaceMemorySource.find_tunnels`
+and :meth:`memchorus.mempalace_memory_source.MemPalaceMemorySource.follow_tunnels`,
+which return ``None``-on-exception for the degradable-by-default property.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Callable, Dict, List, Optional
+
+__all__ = ["tunnel_linked_rooms", "tunnel_adjacent", "tunnel_tag"]
+
+# ---------------------------------------------------------------------------
+# Tokenizer (kept local to this module so we don't couple to content_similarity)
+# ---------------------------------------------------------------------------
+
+_TOKEN_RE = re.compile(r"[a-z0-9_]+")
+
+
+def _tokenize(text: Any) -> set:
+    """Lower-cased alphanumeric token set of *text* (empty set when not str)."""
+    if not isinstance(text, str):
+        return set()
+    return {t.lower() for t in _TOKEN_RE.findall(text)}
+
+
+# ---------------------------------------------------------------------------
+# Core pure functions
+# ---------------------------------------------------------------------------
+
+
+def tunnel_linked_rooms(
+    active_wing: Optional[str],
+    wing_map: Optional[Dict[str, List[str]]] = None,
+) -> List[str]:
+    """Return the list of wings tunnel-linked from *active_wing*.
+
+    Args:
+        active_wing: the active project / wing slug (may be None).
+        wing_map: mapping ``{source_wing: [target_wing, ...]}`` produced by
+            :meth:`MemPalaceMemorySource.find_tunnels`.  Case-insensitive on
+            the source key; case-preserved on the target values.
+
+    Returns:
+        A de-duplicated, order-preserving list of target wing slugs.  An empty
+        list when *active_wing* is falsy, *wing_map* is empty, or no targets
+        exist for *active_wing*.  Never raises.
+    """
+    if not active_wing or not isinstance(wing_map, dict):
+        return []
+    aw = str(active_wing).strip().lower()
+    if not aw:
+        return []
+    found: List[str] = []
+    seen = set()
+    for src, targets in wing_map.items():
+        if not isinstance(targets, (list, tuple)):
+            continue
+        if str(src).strip().lower() != aw:
+            continue
+        for t in targets:
+            ts = str(t).strip()
+            if not ts:
+                continue
+            key = ts.lower()
+            if key in seen:
+                continue
+            seen.add(key)
+            found.append(ts)
+    return found
+
+
+def tunnel_tag(item: Dict[str, Any], active_wing: Optional[str]) -> Dict[str, Any]:
+    """Return a *copy* of *item* tagged as cross-domain.
+
+    Adds (or preserves) three keys on the returned dict:
+      * ``cross_domain`` = True (the stable tag the hooks layer surfaces).
+      * ``tunnel_adjacent_to`` = *active_wing* (case-preserved) — the wing this
+        drawer bridges *from*.
+      * ``source`` is left unchanged.
+
+    Does not mutate *item* (a fresh dict is returned); missing keys become
+    ``None`` / empty on the copy.
+    """
+    out: Dict[str, Any] = dict(item) if isinstance(item, dict) else {"content": item}
+    out["cross_domain"] = True
+    out.setdefault("tunnel_adjacent_to", str(active_wing) if active_wing else None)
+    return out
+
+
+def tunnel_adjacent(
+    drawers: Optional[List[Dict[str, Any]]],
+    active_wing: Optional[str],
+    wing_map: Optional[Dict[str, List[str]]] = None,
+    query: Optional[str] = None,
+    similarity_fn: Optional[Callable[[str, str], float]] = None,
+    min_similarity: float = 0.25,
+    limit: int = 3,
+) -> List[Dict[str, Any]]:
+    """Tunnel-adjacent drawers that pass the similarity floor.
+
+    This is the pure selection step used by
+    :meth:`MemoryOrchestrator.search` when ``cross_domain=True``.  It:
+
+    1. Resolves the set of *tunnel-adjacent wings* of *active_wing* via
+       :func:`tunnel_linked_rooms`.
+    2. Filters *drawers* to those whose ``wing`` field (case-insensitive) is in
+       that set.
+    3. If *query* is a non-empty string and *similarity_fn* is provided, drops
+       any tunnel-adjacent drawer whose ``similarity_fn(query, drawer["content"])``
+       is below *min_similarity*.  When *query* or *similarity_fn* is absent, the
+       floor is skipped (all linked drawers qualify).
+    4. Limits the result to *limit* entries (first-wins order — the caller
+       supplies drawers ranked by their own scorer, so "first" means "most
+       relevant by the caller's own ordering").
+    5. Tags each result via :func:`tunnel_tag`.
+
+    De-duplication: a drawer whose ``key`` has already appeared in the output
+    is skipped (cycle A↔B de-dup, AC f).
+
+    Never raises.  Returns ``[]`` on any malformed input.
+    """
+    if not drawers or not isinstance(drawers, list):
+        return []
+    linked = tunnel_linked_rooms(active_wing, wing_map)
+    if not linked:
+        return []
+    linked_l = {w.lower() for w in linked}
+    q_present = bool(query) and isinstance(query, str)
+    use_floor = (similarity_fn is not None) and q_present
+
+    used_min = 0.0
+    if min_similarity is not None:
+        try:
+            used_min = float(min_similarity)
+            if used_min < 0:
+                used_min = 0.0
+        except Exception:
+            used_min = 0.0
+
+    limit_i = int(limit) if limit and limit > 0 else (len(drawers) or 1)
+    out: List[Dict[str, Any]] = []
+    seen_keys = set()
+    for d in drawers:
+        if not isinstance(d, dict):
+            continue
+        w = d.get("wing")
+        if not isinstance(w, str) or not w.strip():
+            # Drawers with no wing tag are *not* tunnel-adjacent by definition.
+            continue
+        if w.strip().lower() not in linked_l:
+            continue
+        key = d.get("key")
+        key_i = str(key) if key is not None else None
+        if key_i is not None and key_i in seen_keys:
+            continue
+
+        if use_floor:
+            content = d.get("content") or ""
+            try:
+                s = float(similarity_fn(str(query or ""), str(content)))  # type: ignore[misc]
+            except Exception:
+                s = 0.0
+            if s < used_min:
+                continue
+
+        tagged = tunnel_tag(d, active_wing)
+        if key_i is not None:
+            seen_keys.add(key_i)
+        out.append(tagged)
+        if len(out) >= limit_i:
+            break
+    return out
