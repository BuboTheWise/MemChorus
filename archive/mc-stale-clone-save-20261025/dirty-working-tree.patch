@@ -0,0 +1,302 @@
+"""Temporal graph recall — unresolved-pointer resolution (task t_510abeae).
+
+MemChorus issues #223 / #224 / #225 — "temporal graph recall".
+
+Recall items can arrive as *unresolved pointers*:
+
+    **learning-0e0f6c99a4e96624** — source=hermes_default— read it:
+        retrieve(key='learning-0e0f6c99a4e96624').  If that key is missing
+        (cold cache, never saved, or pruned), re-fetch the live source before
+        treating it as absent.
+
+Until this change, that literal instruction text was what the agent saw.  If
+the live source actually held the key, the pointer should be *resolved* to the
+live content; if it did not, the pointer should be rendered as a
+*confirmed-absent* note.  This test pins all five acceptance criteria (AC1-AC5)
+against the real recall path (``on_pre_llm_call`` → ``_resolve_unresolved_pointers``
+→ ``_format_context_block`` → ``_build_context_entries``).
+
+AC1  a recall item with a pointer (``**key**``) + a ``source=`` label + a
+     ``retrieve(key=…)`` call is detected, and the resolver calls the live
+     retrieve with the extracted key.
+AC2  if the live source has content for that key, the recall block contains the
+     resolved live content (not the pointer text).
+AC3  if the live source has no content for that key, the recall block says the
+     key is *confirmed absent* and the key is still present (so it can be
+     re-retrieved) — not a stale "go fetch it" instruction.
+AC4  the hook can never fail: no-key / no-source / retrieve-missing-content
+     cases all produce a recall block and never raise.
+AC5  the 'local-fallback' degrade note is only emitted when the source is truly
+     unavailable — a live resolution must NOT be marked as a local fallback.
+"""
+
+from unittest.mock import patch, MagicMock
+import pytest
+
+import memchorus.hooks as hooks
+
+
+@pytest.fixture(autouse=True)
+def _reset_suppression_window():
+    """Each test starts with a clean cross-turn suppression window.
+
+    The window is module-level state in hooks.py — the live render path marks
+    keys it has already surfaced (key -> content hash), and those keys are
+    suppressed on subsequent renders for the whole session.  Without a reset
+    between tests, one test that renders a given key would suppress it in the
+    next test ("Shown earlier") — which is exactly what the resolver tests
+    need to control: they exercise the *resolution* of a pointer, not
+    cross-turn suppression.
+    """
+    hooks._clear_suppression_windows()
+    yield
+    hooks._clear_suppression_windows()
+
+
+# Canonical pointer shape — exactly the form shipped in the [MemChorus Memory
+# Recall] block (see the task's injected context block).
+POINTER_KEY = "learning-0e0f6c99a4e96624"
+POINTER_BODY = (
+    "**%s** \u2014 source=hermes_default\u2014 read it: "
+    "retrieve(key='%s').  If that key is missing (cold cache, never saved, "
+    "or pruned), re-fetch the live source before treating it as absent."
+    % (POINTER_KEY, POINTER_KEY)
+)
+LIVE_CONTENT = (
+    "CYCLE 6 done. Silent exit fix: cap max 3 concurrent tool calls per turn."
+)
+
+
+def _make_orch(search_results, resolve_map=None, resolve_side_effect=None):
+    """Build a mock orchestrator for the recall path.
+
+    ``resolve_map`` maps key -> content (or None for absent).  Any key not in
+    the map raises KeyError unless a ``resolve_side_effect`` is supplied.
+    """
+    orch = MagicMock(name="MemoryOrchestrator")
+    orch.search.side_effect = lambda *a, **k: list(search_results)
+    if resolve_side_effect is not None:
+        orch.retrieve_with_source.side_effect = resolve_side_effect
+    elif resolve_map is not None:
+        def _rws(key):
+            val = resolve_map.get(key)
+            # ``None`` (or a missing key) models "live source does not hold
+            # this key" — retrieve_with_source returns None for an absent key.
+            if val is None:
+                return None
+            return {
+                "key": key,
+                "content": val,
+                "source_name": "mempalace_mcp",
+            }
+        orch.retrieve_with_source.side_effect = _rws
+    # config: keep guards + balance silent so they don't inject noise blocks.
+    orch.config = {"prohibitions": {"enabled": False}, "balance": {"enabled": False}}
+    return orch
+
+
+def _run_hook(orch):
+    with patch("memchorus.hooks._get_orchestrator", return_value=orch):
+        hook = hooks.MemChorusHooks()
+        return hook.on_pre_llm_call(
+            user_message="work the kanban task",
+            conversation_history=[{"role": "user", "content": "work the kanban task"}],
+            session_id="test-session",
+            task_id="t_510abeae",
+            turn_id=1,
+            is_first_turn=False,
+            model="test-model",
+            platform="cli",
+            sender_id="",
+        )
+
+
+# ---------------------------------------------------------------------------
+# AC1 — pointer + source= + retrieve() is detected; resolver uses the key
+# ---------------------------------------------------------------------------
+class TestAC1PointerDetected:
+    def test_pointer_body_recognised(self):
+        is_ptr, key, source = hooks._is_unresolved_pointer(POINTER_BODY)
+        assert is_ptr is True
+        assert key == POINTER_KEY
+        assert source == "hermes_default"
+
+    def test_resolver_calls_live_retrieve_with_extracted_key(self):
+        orch = _make_orch(
+            search_results=[
+                {"key": POINTER_KEY, "content": POINTER_BODY, "source": "hermes_default",
+                 "score": 0.9, "preview": POINTER_BODY[:80]},
+            ],
+            resolve_map={POINTER_KEY: LIVE_CONTENT},
+        )
+        _run_hook(orch)
+        # AC1: the resolver MUST have asked the live source for the exact key.
+        assert orch.retrieve_with_source.called, (
+            "resolver did not call the live retrieve() at all"
+        )
+        called_keys = [c.args[0] for c in orch.retrieve_with_source.call_args_list]
+        assert POINTER_KEY in called_keys, (
+            "resolver did not request the extracted pointer key %r (called: %r)"
+            % (POINTER_KEY, called_keys)
+        )
+
+
+# ---------------------------------------------------------------------------
+# AC2 — live source has content -> block contains resolved content
+# ---------------------------------------------------------------------------
+class TestAC2ResolvedInline:
+    def test_resolved_live_content_present_pointer_gone(self):
+        orch = _make_orch(
+            search_results=[
+                {"key": POINTER_KEY, "content": POINTER_BODY, "source": "hermes_default",
+                 "score": 0.9, "preview": POINTER_BODY[:80]},
+            ],
+            resolve_map={POINTER_KEY: LIVE_CONTENT},
+        )
+        result = _run_hook(orch)
+        assert result is not None
+        ctx = result["context"]
+        # AC2: the resolved live material is what the agent sees…
+        assert LIVE_CONTENT in ctx, (
+            "resolved live content missing from recall block:\n%s" % ctx
+        )
+        # …not the stale "read it: retrieve(key=…)" pointer instruction.
+        assert "read it:" not in ctx, (
+            "stale pointer instruction still present after resolution:\n%s" % ctx
+        )
+        # The key is still named (resolvable) but the "go fetch" framing is gone.
+        assert POINTER_KEY in ctx
+
+
+# ---------------------------------------------------------------------------
+# AC3 — live source has NO content -> confirmed-absent note, key retained
+# ---------------------------------------------------------------------------
+class TestAC3ConfirmedAbsent:
+    def test_absent_note_keeps_key_and_drops_go_fetch(self):
+        orch = _make_orch(
+            search_results=[
+                {"key": POINTER_KEY, "content": POINTER_BODY, "source": "hermes_default",
+                 "score": 0.9, "preview": POINTER_BODY[:80]},
+            ],
+            resolve_map={POINTER_KEY: None},  # live source does NOT hold the key
+        )
+        result = _run_hook(orch)
+        assert result is not None
+        ctx = result["context"]
+        assert POINTER_KEY in ctx, "key must survive a confirmed-absent render"
+        assert "absent" in ctx.lower(), (
+            "expected a 'confirmed absent' note, got:\n%s" % ctx
+        )
+        assert "read it:" not in ctx, (
+            "confirmed-absent render must not look like a stale 'go fetch it':\n%s" % ctx
+        )
+
+
+# ---------------------------------------------------------------------------
+# AC4 — the hook can never fail (no-key / no-source / retrieve-raises)
+# ---------------------------------------------------------------------------
+class TestAC4NeverFails:
+    def test_retrieve_raising_does_not_break_hook(self):
+        def _raise(key):
+            raise RuntimeError("live source blew up")
+        orch = _make_orch(
+            search_results=[
+                {"key": POINTER_KEY, "content": POINTER_BODY, "source": "hermes_default",
+                 "score": 0.9, "preview": POINTER_BODY[:80]},
+            ],
+            resolve_side_effect=_raise,
+        )
+        result = _run_hook(orch)  # must NOT raise
+        assert result is not None
+        # the original pointer text is preserved for the failing key
+        assert POINTER_KEY in result["context"]
+
+    def test_non_pointer_item_leaves_block_alone(self):
+        orch = _make_orch(
+            search_results=[
+                {"key": "prose-1", "content": "Always cap tool calls to three per turn.",
+                 "source": "hermes_default", "score": 0.7,
+                 "preview": "Always cap tool calls"},
+            ],
+            resolve_map={},
+        )
+        result = _run_hook(orch)
+        assert result is not None
+        assert "Always cap tool calls to three per turn." in result["context"]
+        # prose is not a pointer -> resolver must not have touched the live source
+        assert not orch.retrieve_with_source.called
+
+    def test_no_search_results_returns_none_gracefully(self):
+        orch = _make_orch(search_results=[], resolve_map={})
+        with patch("memchorus.hooks._get_orchestrator", return_value=orch):
+            # A guard/feedback line may still appear, but recall must be absent.
+            result = hooks.MemChorusHooks().on_pre_llm_call(
+                user_message="work", conversation_history=[],
+                session_id="s", task_id="", turn_id=1, is_first_turn=False,
+                model="m", platform="cli", sender_id="",
+            )
+        # No recall items -> no [MemChorus Memory Recall] bracket required.
+        if result is not None:
+            assert "[MemChorus Memory Recall]" not in result["context"]
+
+    def test_resolver_unit_never_raises_on_odd_types(self):
+        items = [
+            {"key": "a", "content": None, "source": "x", "score": 1.0},
+            {"key": "b", "content": 12345, "source": "x", "score": 1.0},
+            {"key": "c", "content": ["a", "b"], "source": "x", "score": 1.0},
+            "not-a-dict",
+        ]
+        orch = MagicMock()
+        enriched, report = hooks._resolve_unresolved_pointers(items, orch)
+        assert len(enriched) == len(items)
+        # None of these are documented pointers -> nothing resolved.
+        assert report["resolved"] == []
+        assert report["missing"] == []
+        assert report["unresolved"] == []
+
+
+# ---------------------------------------------------------------------------
+# AC5 — 'local-fallback' degrade note only when source is truly unavailable
+# ---------------------------------------------------------------------------
+class TestAC5LocalFallbackGating:
+    def test_live_resolution_not_marked_local_fallback(self):
+        orch = _make_orch(
+            search_results=[
+                {"key": POINTER_KEY, "content": POINTER_BODY, "source": "hermes_default",
+                 "score": 0.9, "preview": POINTER_BODY[:80]},
+            ],
+            resolve_map={POINTER_KEY: LIVE_CONTENT},
+        )
+        result = _run_hook(orch)
+        ctx = result["context"]
+        assert LIVE_CONTENT in ctx
+        # The resolved item's source is the live source, never 'local-fallback'.
+        lowered = ctx.lower()
+        assert "local-fallback" not in lowered.replace(" ", ""), (
+            "a successfully resolved live item must not be flagged local-fallback:\n%s" % ctx
+        )
+
+    def test_resolve_report_structure(self):
+        """The resolver returns a machine-readable report (resolved/missing/unresolved)."""
+        orch = MagicMock()
+        orch.retrieve_with_source.side_effect = {
+            POINTER_KEY: {"key": POINTER_KEY, "content": LIVE_CONTENT, "source_name": "mempalace_mcp"},
+        }.get
+        items = [
+            {"key": POINTER_KEY, "content": POINTER_BODY, "source": "hermes_default",
+             "score": 0.9, "preview": POINTER_BODY[:40]},
+        ]
+        enriched, report = hooks._resolve_unresolved_pointers(items, orch)
+        assert len(enriched) == 1
+        assert len(report["resolved"]) == 1
+        assert report["resolved"][0]["key"] == POINTER_KEY
+        assert report["resolved"][0]["source_name"] == "mempalace_mcp"
+        # The enriched item now carries the live content, not the pointer.
+        assert enriched[0]["content"] == LIVE_CONTENT
+        assert enriched[0]["source"] == "mempalace_mcp"
+        assert enriched[0].get("resolved_from_pointer") is True
+
+
+if __name__ == "__main__":
+    import sys
+    sys.exit(pytest.main([__file__, "-v"]))
