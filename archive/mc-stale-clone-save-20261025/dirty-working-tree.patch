             injected_blocks: List[str] = []
 
             # Guards go first so they appear before soft recall / feedback blocks
@@ -1641,6 +1655,191 @@ def _should_collapse_low_signal(body: str) -> bool:
     return False
 
 
+# ---------------------------------------------------------------------------
+# Unresolved-pointer resolution (task t_510abeae / MemChorus issues #223/#224/#225
+# "temporal graph recall")
+#
+# The recall block currently surfaces pointer-shaped items — e.g.
+#   **learning-0e0f6c99a4e96624** — source=hermes_default— read it:
+#       retrieve(key='learning-0e0f6c99a4e96624').  If that key is missing
+#       (cold cache, never saved, or pruned), re-fetch the live source before
+#       treating it as absent.
+# — as literal text, even when the underlying memory has already been resolved.
+# The pointer itself is a "recall pointer": the agent is handed a key and told
+# to call ``retrieve``.  When the live source actually *does* hold that key,
+# the pointer should be replaced by the resolved live content so the model
+# immediately sees the material without an extra round-trip; when the live
+# source does *not* hold the key, the pointer must be rendered as a *confirmed
+# absent* note rather than a stale "go fetch it" instruction.  Either way, the
+# key stays reachable, and the "local-fallback" path is only used when the
+# live source itself is truly unavailable.
+#
+# This is a *seam*-only change: the resolution happens between the search
+# (``orchestrator.search``) and the render (``_format_context_block``),
+# leaving ``_build_context_entries`` — the single render core — untouched.
+# ---------------------------------------------------------------------------
+
+# Matches a documented MemChorus pointer in an injected recall item body.
+# The documented form is ``**<key>** — source=<X>— read it: retrieve(key=…)`` —
+# canonical em-dash between the key and the ``source=`` label.  Both em-dash /
+# en-dash / hyphen separators and both the spaced and unspaced ``read it:``
+# variants are captured.  A plain word or prose body is NOT a pointer —
+# only bodies that (1) start with a **bold** key token, (2) carry a ``—`` (or
+# ``--``) separator, and (3) carry a ``source=<value>`` label are treated as
+# unresolved pointers.
+_POINTER_KEY_RE = re.compile(
+    r"^\s*\*\*(?P<key>[A-Za-z][A-Za-z0-9_.\-]*)\*\*\s*"
+    r"(?:[—–-]{1,2})\s*"
+    r"(?:source=(?P<source>[A-Za-z0-9_./\-:]+?)\s*(?:[—–-]{1,2})?\s*read\s+it:)?",
+    re.UNICODE,
+)
+
+# Sentinel returned by the resolver for items whose ``retrieve_with_source``
+# call raises.  The renderer must fall back to the original pointer text for
+# these — the hook MUST never crash because a single live-source lookup failed.
+_RESOLUTION_RAISED = object()
+
+
+def _is_unresolved_pointer(body: Any) -> tuple:
+    """Return ``(is_pointer, key, source)`` for a recall item body.
+
+    Only the *documented* pointer shape is recognised:
+
+    * body is a ``str`` (not None / not a raw tool envelope)
+    * the body starts with a ``**<key>**`` token (bold key)
+    * the body contains a ``—`` or ``--`` separator between the key and the
+      rest of the text
+    * either a ``source=<value>`` label OR a ``read it: retrieve(key=…)``
+      instruction is present
+
+    Returns ``(False, "", "")`` when the body is not a pointer.
+    """
+    if body is None:
+        return (False, "", "")
+    if not isinstance(body, str):
+        return (False, "", "")
+    # Quick structural pre-filter — if there is no bold token, no dash, and no
+    # retrieve/source label, this cannot be the documented pointer.
+    low = body
+    if "**" not in low:
+        return (False, "", "")
+    if ("—" not in low and "--" not in low):
+        return (False, "", "")
+    if "read it:" not in low and "source=" not in low:
+        return (False, "", "")
+    m = _POINTER_KEY_RE.match(low)
+    if m is None:
+        return (False, "", "")
+    key = (m.group("key") or "").strip()
+    if not key:
+        return (False, "", "")
+    source = (m.group("source") or "").strip()
+    return (True, key, source)
+
+
+def _resolve_unresolved_pointers(
+    items: List[Dict[str, Any]],
+    orchestrator: Any,
+) -> tuple:
+    """Resolve every ``**<key>**`` pointer in ``items`` against the live source.
+
+    For each item whose body is an unresolved pointer and whose ``key`` can
+    be resolved via ``orchestrator.retrieve_with_source(key)``:
+
+    * if the live source is found → the item is replaced by a resolved
+      entry: the pointer text is dropped, the live content is inlined, and
+      the item's ``source`` field is set to the live source name (e.g.
+      ``mempalace_mcp``), so the renderer's inline path — not the low-signal
+      gate — inlines the material and the model sees it immediately;
+    * if the live source is NOT found → the item is replaced by an
+      *absent-confirmation* entry that still carries the key (so the agent
+      can re-issue ``retrieve`` if it wants) but no longer looks like a
+      "go fetch it" instruction.
+
+    For pointer items whose lookup raises, the item is left untouched —
+    the hook MUST not crash because a single live-source lookup failed
+    (AC4: "the hook can never fail").
+
+    Returns ``(enriched_items, report)`` where ``report`` is a dict with:
+      - ``resolved``: list of ``{"key", "source_name", "content"}``
+      - ``missing``:  list of keys confirmed absent from the live source
+      - ``unresolved``: list of keys whose ``retrieve_with_source`` raised
+                        (the original pointer is preserved for these)
+
+    Never raises.  Never mutates the input ``items`` list in place — it
+    returns a new list (the caller replaces its local variable).
+    """
+    resolved: List[Dict[str, Any]] = []
+    missing: List[str] = []
+    unresolved: List[str] = []
+    enriched: List[Dict[str, Any]] = []
+
+    for item in items:
+        if not isinstance(item, dict):
+            enriched.append(item)
+            continue
+        body = item.get("content")
+        is_ptr, key, _source = _is_unresolved_pointer(body)
+        if not is_ptr:
+            enriched.append(item)
+            continue
+        # The key was detected as a pointer — attempt to resolve it against
+        # the live source.  Use retrieve_with_source() (not retrieve()) so
+        # we also learn which source actually held the value (this matters
+        # for the rendered note and for the report).
+        try:
+            hit = orchestrator.retrieve_with_source(key)
+        except Exception as exc:
+            logger.warning(
+                "recall.resolve: retrieve_with_source(%r) raised: %s",
+                key, exc,
+            )
+            unresolved.append(key)
+            enriched.append(item)  # leave the original pointer in place
+            continue
+
+        resolved_item = dict(item)  # shallow copy — do not mutate the caller's dict
+        if hit is not None:
+            live_content = hit.get("content")
+            live_source = hit.get("source_name") or "unknown"
+            resolved_item["content"] = live_content
+            resolved_item["source"] = live_source
+            resolved_item["resolved_from_pointer"] = True
+            # Clear any stale status markers left on the original pointer
+            # (e.g. "unresolved", "cold_cache", "local_fallback") — the
+            # pointer is now *confirmed resolved* against a live source.
+            for k in ("unresolved", "cold_cache", "local_fallback", "missing"):
+                resolved_item.pop(k, None)
+            resolved.append(
+                {"key": key, "source_name": live_source, "content": live_content}
+            )
+            logger.info(
+                "recall.resolve: %r resolved from live source %r (%d chars)",
+                key, live_source,
+                len(live_content) if live_content is not None else 0,
+            )
+        else:
+            # Live source does not hold this key.  Render a confirmed-absent
+            # note — the key is still present (so a re-retrieve works) but the
+            # agent is explicitly told this is NOT a "go fetch it" pointer.
+            resolved_item["content"] = (
+                "**%s** — absent from live source (cold cache or pruned; "
+                "re-issue retrieve(key='%s') only if the store is now available)"
+                % (key, key)
+            )
+            resolved_item["resolved_from_pointer"] = True
+            resolved_item["absent_from"] = "live_source"
+            for k in ("unresolved", "cold_cache", "local_fallback", "missing"):
+                resolved_item.pop(k, None)
+            resolved_item.pop("source", None)
+            missing.append(key)
+            logger.info("recall.resolve: %r confirmed absent from live source", key)
+        enriched.append(resolved_item)
+
+    report = {"resolved": resolved, "missing": missing, "unresolved": unresolved}
+    return (enriched, report)
+
+
 def _render_project_record_block(project_name: str, record: Any) -> str:
