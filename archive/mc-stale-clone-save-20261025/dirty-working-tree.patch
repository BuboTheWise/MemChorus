diff --git a/src/memchorus/diary_signal.py b/src/memchorus/diary_signal.py
new file mode 100644
index 0000000..1029c01
--- /dev/null
+++ b/src/memchorus/diary_signal.py
@@ -0,0 +1,150 @@
+"""
+Diary-voice recall signal (MemChorus issue #225, sub-part 2).
+
+Wires MemPalace's per-agent diary (written in AAAK — a compressed
+narrative of what the agent worked on and why) into the auto-recall loop
+as a *distinct, labelled* agent-voice section.
+
+Design principle: **pure, testable, degradable.**  The two public
+functions here never talk to the network, never throw, and always fall
+back to ``[]`` when their inputs are missing or malformed.  That lets the
+orchestrator's recall path call them unconditionally and let the *data* —
+not the caller — decide whether diary context is available.
+
+API:
+    diary_voice(diary_entries, task_description, limit=3,
+                similarity_fn=None, min_similarity=0.2)
+
+        Given *task_description* (the current task prompt / reason for the
+        recall) and a list of *diary_entries* (each a dict with a ``text``
+        or ``content`` key — AAAK-compressed narrative), return up to
+        *limit* entries tagged with ``agent_diary=True`` and
+        ``diary_relevant_for=task_description``.
+
+        Filtering:
+          1. Drop any entry whose text (or content) is empty / non-textual.
+          2. When *similarity_fn* is provided (caller-supplied — e.g.
+             :func:`memchorus.content_similarity.jaccard_similarity`),
+             drop entries whose ``similarity_fn(task_description, entry_text)``
+             is strictly below *min_similarity*.
+          3. Limit to *limit* (first-wins — the caller supplies diary entries
+             most-recent-first, so "first" means "most-recent qualifying").
+
+        Never raises.  Returns ``[]`` on any malformed input.
+
+    diary_tag(diary_entry, task_description) -> dict
+        Return a *copy* of *entry* tagged as agent-diary-voice:
+          - ``agent_diary`` = True (the stable tag the hooks layer surfaces).
+          - ``diary_relevant_for`` = *task_description* (the task that
+            triggered this inclusion; ``None`` when the caller didn't pass one).
+        Does not mutate the input; a fresh dict is returned.
+        Non-dict entries are wrapped into ``{"agent_diary": True, "content": <entry>, ...}``.
+
+Backward compatibility: when *diary_entries* is empty / ``None`` or
+*task_description* is ``None`` or ``""``, the output is ``[]`` and the recall
+block renders *unchanged* (regression guard — the diary section is absent).
+
+This module is intentionally *small*: it is the *pure* half of the diary-voice
+signal.  The I/O half (fetching ``diary_read`` from the MemPalace MCP) lives
+in :meth:`memchorus.mempalace_memory_source.MemPalaceMemorySource.diary_read`,
+which returns ``None``-on-exception for the degradable-by-default property.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+__all__ = ["diary_voice", "diary_tag"]
+
+
+def _entry_text(entry: Any) -> Optional[str]:
+    """Extract the rankable text of a diary entry (``None`` when no text)."""
+    if not isinstance(entry, dict):
+        return entry if isinstance(entry, str) else None
+    for k in ("text", "content", "body"):
+        v = entry.get(k)
+        if isinstance(v, str) and v.strip():
+            return v
+    return None
+
+
+def diary_tag(entry: Any, task_description: Optional[str] = None) -> Dict[str, Any]:
+    """Return a *copy* of *entry* tagged as agent-diary-voice.
+
+    Preserves all original keys; adds:
+      - ``agent_diary`` = True  (the stable tag the hooks layer surfaces).
+      - ``diary_relevant_for`` = *task_description* (or ``None``).
+
+    Does not mutate the input; a fresh dict is returned.  Non-dict entries
+    are wrapped into a single-field dict.
+    """
+    if isinstance(entry, dict):
+        out: Dict[str, Any] = dict(entry)
+    else:
+        out = {"content": entry if entry is not None else ""}
+    out["agent_diary"] = True
+    out.setdefault("diary_relevant_for", task_description)
+    return out
+
+
+def diary_voice(
+    diary_entries: Optional[List[Any]],
+    task_description: Optional[str],
+    limit: int = 3,
+    similarity_fn: Optional[Any] = None,
+    min_similarity: float = 0.2,
+) -> List[Dict[str, Any]]:
+    """Select diary entries relevant to *task_description*.
+
+    This is the pure selection step used by
+    :meth:`MemoryOrchestrator.search` when ``include_diary=True``.  It:
+
+    1. Drops any entry with no extractable text (empty / non-string).
+    2. If *task_description* is a non-empty string and *similarity_fn* is
+       provided, drops entries whose ``similarity_fn(task_description, text)``
+       is strictly below *min_similarity*.  When either is absent, all
+       text-bearing entries qualify (conservative default).
+    3. Limits the output to *limit* entries (first-wins order — the caller
+       typically supplies diary entries most-recent-first, so "first" means
+       "most-recent qualifying"); a duplicate text in the output is de-duped
+       (same narrative text appearing in two diary entries counts once).
+
+    Never raises.  Returns ``[]`` on any malformed input, and never returns
+    entries that carry no extractable text.
+    """
+    if not diary_entries or not isinstance(diary_entries, list):
+        return []
+    task = (task_description or "").strip() if isinstance(task_description, str) else ""
+    use_floor = (similarity_fn is not None) and bool(task)
+
+    min_s = 0.0
+    if min_similarity is not None:
+        try:
+            min_s = float(min_similarity)
+            if min_s < 0:
+                min_s = 0.0
+        except Exception:
+            min_s = 0.0
+
+    limit_i = int(limit) if limit and limit > 0 else (len(diary_entries) or 1)
+    out: List[Dict[str, Any]] = []
+    seen = set()
+    for entry in diary_entries:
+        text = _entry_text(entry)
+        if text is None or not text.strip():
+            continue
+        norm = text.strip().lower()
+        if norm in seen:
+            continue
+        if use_floor:
+            try:
+                s = float(similarity_fn(task, text))  # type: ignore[misc]
+            except Exception:
+                s = 0.0
+            if s < min_s:
+                continue
+        seen.add(norm)
+        out.append(diary_tag(entry, task_description))
+        if len(out) >= limit_i:
+            break
+    return out
diff --git a/src/memchorus/event_provenance.py b/src/memchorus/event_provenance.py
new file mode 100644
index 0000000..7cb2864
--- /dev/null
+++ b/src/memchorus/event_provenance.py
@@ -0,0 +1,193 @@
+"""
+Event/artifact provenance annotation (MemChorus issue #225, sub-part 3).
+
+When a drawer was *stored as the outcome of a coordination event* (a
+``patch.ready``, ``task.reply``, or ``artifact_put`` in the event log that
+references this drawer's key / content), annotate the ranked entry with the
+event context — who handed what to whom, against which baseline.
+
+This module is *pure*: it never talks to the network, never throws, and
+always returns ``None`` when it cannot produce a provenance note.  The
+orchestrator's recall path calls :func:`annotate` for each ranked drawer
+against the recent event log; a drawer without a matching event leaves the
+annotation ``None`` (the hooks layer then renders nothing — unchanged).
+
+Design principle: **safe, compact, most-recent-wins.**  The annotation is a
+single short string (under 80 chars) so it does not bloat the recall block.
+When multiple events reference the same drawer, only the most recent one is
+used — not all (AC d).
+
+API:
+    annotate(drawer, event_log, max_chars=80) -> Optional[str]
+        Given a ranked drawer (dict with a ``key``) and a list of event
+        records (each a dict with ``id`` / ``created_at`` / ``metadata`` /
+        ``type`` keys), return a compact provenance note if some event in
+        *event_log* references this drawer's key (or a correlation_id that
+        matches this drawer's key), else ``None``.
+
+        Reference matching — an event "references" the drawer when ANY of:
+          * ``event["metadata"]["drawer_key"] == drawer["key"]``
+          * ``event["metadata"]["correlation_id"] == drawer["key"]``
+          * ``event["id"] == drawer["key"]``
+          * ``event["key"] == drawer["key"]``
+        (case-insensitive on both sides).
+
+        Most-recent-wins: when several match, the event with the latest
+        ``created_at`` (ISO-8601 or epoch seconds, both accepted) is the one
+        whose provenance we annotate.  Ties → the last one in list order
+        wins (deterministic, stable).
+
+        Never raises.  Returns ``None`` when no event matches, the drawer
+        has no key, the event log is empty, or the assembled note exceeds
+        *max_chars* and cannot be shortened.
+
+
+Backward compatibility: when *event_log* is empty / ``None`` / or no event
+references the drawer, the return is ``None`` and the hooks layer renders
+nothing — the recall block is byte-identical to pre-#225.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from typing import Any, Dict, List, Optional
+
+__all__ = ["annotate"]
+
+# Compact prefixes per event type (kept short to stay under the 80-char budget).
+# ``task.request`` is a *delegation* (not an outcome), so we use a "delegated"
+# verb; ``task.reply`` is an outcome, "replied to"; ``patch.ready`` is a
+# completed patch, "patch"; ``artifact_put`` stores an artifact, "artifact".
+_TYPE_VERB = {
+    "task.request": "delegated",
+    "task.reply": "replied to",
+    "patch.ready": "patch",
+    "patch.submit": "patch",
+    "artifact_put": "artifact",
+    "artifact_get": "artifact",
+    "event.ack": "acked",
+}
+
+
+def _event_ts(event: Dict[str, Any]) -> Optional[float]:
+    """Best-effort epoch-seconds timestamp of *event* (``None`` when no ts)."""
+    for k in ("created_at", "timestamp", "ts"):
+        v = event.get(k)
+        if v is None:
+            continue
+        try:
+            if isinstance(v, (int, float)):
+                return float(v)
+            if isinstance(v, str):
+                s = v.strip().replace("Z", "+00:00")
+                dt = datetime.fromisoformat(s)
+                if dt.tzinfo is None:
+                    dt = dt.replace(tzinfo=timezone.utc)
+                return dt.timestamp()
+        except Exception:
+            continue
+    return None
+
+
+def _event_correlation_id(event: Dict[str, Any]) -> Optional[str]:
+    """The event's correlation id (the drawer it references)."""
+    for k in ("correlation_id", "drawer_key", "key", "event_id"):
+        v = event.get(k)
+        if isinstance(v, str) and v.strip():
+            return v.strip()
+    md = event.get("metadata")
+    if isinstance(md, dict):
+        for k in ("drawer_key", "correlation_id", "key"):
+            v = md.get(k)
+            if isinstance(v, str) and v.strip():
+                return v.strip()
+    return None
+
+
+def _event_agent_role(event: Dict[str, Any]) -> Optional[str]:
+    """The *to* agent / role of the event (the "handed to" party)."""
+    for k in ("to_agent", "agent_role", "to", "role"):
+        v = event.get(k)
+        if isinstance(v, str) and v.strip():
+            return v.strip()
+    md = event.get("metadata")
+    if isinstance(md, dict):
+        for k in ("to_agent", "agent_role"):
+            v = md.get(k)
+            if isinstance(v, str) and v.strip():
+                return v.strip()
+    return None
+
+
+def annotate(
+    drawer: Optional[Dict[str, Any]],
+    event_log: Optional[List[Dict[str, Any]]],
+    max_chars: int = 80,
+) -> Optional[str]:
+    """Return a compact provenance note for *drawer* (``None`` when no event
+    references it).
+
+    See the module docstring for matching rules, most-recent-wins semantics,
+    and the compact 80-char budget.
+    """
+    if not isinstance(drawer, dict):
+        return None
+    key = drawer.get("key")
+    if not isinstance(key, str) or not key.strip():
+        return None
+    key_l = key.strip().lower()
+
+    if not event_log or not isinstance(event_log, list):
+        return None
+
+    # Collect candidates: (ts, list_index, event) for events referencing this key.
+    matches: List[tuple] = []
+    for i, ev in enumerate(event_log):
+        if not isinstance(ev, dict):
+            continue
+        cids = []
+        cid = _event_correlation_id(ev)
+        if cid:
+            cids.append(cid)
+        # Also check any event-level ``key`` / ``id`` that the drawer may share.
+        for src_key in ("key", "id", "event_id"):
+            v = ev.get(src_key)
+            if isinstance(v, str) and v.strip():
+                cids.append(v.strip())
+        ev_type = str(ev.get("type") or "").strip().lower()
+        role = _event_agent_role(ev)
+        for cid in cids:
+            if cid.lower() == key_l:
+                ts = _event_ts(ev)
+                matches.append((ts, i, ev_type, role))
+                break
+
+    if not matches:
+        return None
+
+    # Most-recent-wins: sort by ts desc (with stable tie-breaking by list order),
+    # take the head.  ``None`` ts sorts last (no time signal → prefer timed).
+    def _sort_key(m: tuple) -> tuple:
+        ts, i, et, role = m
+        # (negated ts so desc; None → -inf; list index asc; type/role for determinism)
+        return (-(ts if ts is not None else float("-inf")), i)
+
+    matches.sort(key=_sort_key)
+    ts, _i, etype, role = matches[0]
+
+    # Compose a compact note: the verb (event type) + the key it referenced,
+    # plus the "via <role>" clause when the event named a hand-off target.
+    note = "originated as %s (key:%s)" % (etype or "event", key)
+    if role:
+        note += " via " + role
+    # Enforce the budget.  If over budget, drop the role clause first, then
+    # fall back to the type + key alone (which the 80-char budget can always
+    # accommodate for reasonable key lengths).
+    if len(note) > max_chars:
+        note = "originated as %s (key:%s)" % (etype or "event", key)
+        if len(note) > max_chars:
+            room = max(8, max_chars - len("originated as %s (key:)" % (etype or "event")))
+            note = "originated as %s (key:%s)" % (etype or "event", key[:room])
+    if len(note) > max_chars:
+        return None
+    return note.strip()
diff --git a/src/memchorus/hooks.py b/src/memchorus/hooks.py
index 5d38b27..b8d8331 100644
--- a/src/memchorus/hooks.py
+++ b/src/memchorus/hooks.py
@@ -347,6 +347,20 @@ class MemChorusHooks:
             # only does exact-key lookup and doesn't accept a limit param.
             context_items = orchestrator.search(enriched_terms, limit=search_limit)
 
+            # (task t_510abeae / issues #223/#224/#225 — temporal graph recall)
